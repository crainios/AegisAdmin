[Unit]
Description=Generate the private AegisAdmin download dashboard
Wants=network-online.target
After=network-online.target apache2.service

[Service]
Type=oneshot
User=www-data
Group=www-data
SupplementaryGroups=adm
UMask=0027
StateDirectory=aegisadmin-download-stats
StateDirectoryMode=0750
ExecStart=/usr/local/libexec/aegisadmin-download-stats -logs /var/log/apache2/aegisadmin-packages-access.log* -output /var/lib/aegisadmin-download-stats/public
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/var/log/apache2
ReadWritePaths=/var/lib/aegisadmin-download-stats
