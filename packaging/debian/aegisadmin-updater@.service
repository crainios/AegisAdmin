[Unit]
Description=AegisAdmin independent package updater (%i)
Documentation=file:/usr/share/doc/aegisadmin/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/aegisadmin/aegisadmin-updater --job %i --state-directory /var/lib/aegisadmin/updates
TimeoutStartSec=2h10min
UMask=0027
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
# L’installation légitime d’un noyau doit pouvoir écrire dans /usr/lib/modules.
ProtectKernelModules=false
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
